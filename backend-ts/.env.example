AIVISTA_JAVA_LOCAL_YAML=
AIVISTA_DB_HOST=127.0.0.1
AIVISTA_DB_PORT=3306
AIVISTA_DB_NAME=aivista
AIVISTA_DB_USERNAME=
AIVISTA_DB_PASSWORD=
AIVISTA_RABBITMQ_HOST=
AIVISTA_RABBITMQ_PORT=5672
AIVISTA_RABBITMQ_USERNAME=
AIVISTA_RABBITMQ_PASSWORD=
AIVISTA_RABBITMQ_VHOST=/aivista
AIVISTA_GENERATION_QUEUE_ENABLED=false
AIVISTA_BAILIAN_ENDPOINT=
AIVISTA_BAILIAN_API_KEY=
AIVISTA_AGENT_ENABLED=false
AIVISTA_AGENT_MODEL=qwen3.8-flash
AIVISTA_AGENT_BAILIAN_BASE_URL=
# Optional override. When empty, AIVISTA_BAILIAN_API_KEY is reused.
AIVISTA_AGENT_BAILIAN_API_KEY=
AIVISTA_AGENT_THINKING_ENABLED=false
AIVISTA_AGENT_MAX_TURNS=20
AIVISTA_AGENT_MAX_CONCURRENT=4
AIVISTA_AGENT_LOOP_TIMEOUT_MS=1200000
AIVISTA_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
AIVISTA_OSS_ENDPOINT=
AIVISTA_OSS_BUCKET=
AIVISTA_OSS_ACCESS_KEY_ID=
AIVISTA_OSS_ACCESS_KEY_SECRET=

AIVISTA_RUNTIME_HOST=127.0.0.1
AIVISTA_RUNTIME_PORT=8890
AIVISTA_SESSION_DIRECTORY=./var/sessions
AIVISTA_JAVA_BASE_URL=http://127.0.0.1:8888/api
AIVISTA_GENERATION_WORKER_TOKEN=

AIVISTA_GENERATION_MODEL=bailian/qwen-image-2.0
AIVISTA_GENERATION_DAILY_IMAGE_QUOTA=12
AIVISTA_GENERATION_MAX_ACTIVE_PER_USER=4
AIVISTA_OSS_OBJECT_PREFIX=users
