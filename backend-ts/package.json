{
  "name": "@aivista/backend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm prisma:generate && pnpm clean && tsc -p tsconfig.build.json",
    "worker": "node dist/worker.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm prisma:generate && vitest run test --exclude test/integration/** --pool=forks --maxWorkers=1",
    "test:schema": "pnpm prisma:generate && vitest run test/execution-repository.integration.test.ts --pool=forks --maxWorkers=1",
    "test:agent-smoke": "vitest run test/integration/pi-bailian-smoke.test.ts --pool=threads",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:introspect": "prisma db pull --config prisma7.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@langfuse/otel": "5.11.1",
    "@langfuse/tracing": "5.11.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "ali-oss": "^6.23.0",
    "amqplib": "2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typebox": "1.3.7",
    "ws": "8.21.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@types/ali-oss": "^6.23.3",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "mysql2": "^3.15.3"
  },
  "packageManager": "pnpm@10.15.0"
}
